#!/usr/bin/env python3
"""commit-msg hook for uTmax6: the commit history is the change log.

Refuses a commit unless
  1. the message has a body (a blank line after the summary, then text),
  2. the body names every file the commit changes (full path or file name), and
  3. CHANGES.md is part of the commit whenever a file under src/ changes.
Merge commits are let through. Turn the hook on with:
    git config core.hooksPath tools/hooks
"""
import os
import subprocess
import sys

msg_file = sys.argv[1]
with open(msg_file, encoding="utf-8") as f:
    lines = [l.rstrip("\n") for l in f if not l.startswith("#")]
text = "\n".join(lines).strip()

# Merges and the initial import are recorded by their own messages.
if os.path.exists(os.path.join(os.environ.get("GIT_DIR", ".git"), "MERGE_HEAD")):
    sys.exit(0)

problems = []
parts = text.split("\n\n", 1)
body = parts[1].strip() if len(parts) > 1 else ""
if not body:
    problems.append("The message has no body. After the summary line, leave a blank line "
                    "and describe every changed file and why.")

staged = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACDMRT"],
                        capture_output=True, text=True, check=True).stdout.split()
missing = [p for p in staged if p not in body and os.path.basename(p) not in body]
# A whole new folder may be described once by its folder name.
missing = [p for p in missing if not any(d and (d + "/") in body
                                         for d in [os.path.dirname(p)])]
if missing:
    problems.append("These changed files are not mentioned in the message body:\n    "
                    + "\n    ".join(missing))

if any(p.startswith("src/") for p in staged) and "CHANGES.md" not in staged:
    problems.append("Code under src/ changed but CHANGES.md is not in the commit.")

if problems:
    sys.stderr.write("\ncommit refused by tools/hooks/commit-msg:\n\n- "
                     + "\n- ".join(problems)
                     + "\n\nSee CONTRIBUTING.md, 'Every commit explains itself'.\n\n")
    sys.exit(1)
